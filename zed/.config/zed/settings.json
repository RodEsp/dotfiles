// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "dprint": {
      "binary": {
        "path": "/opt/homebrew/bin/dprint",
        "arguments": ["lsp"],
      },
      "enable_lsp_tasks": true,
    },
    "markdownlint": {
      "settings": {
        "MD013": false,
      },
    },
  },
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "disable_ai": false,
  "inlay_hints": {
    "enabled": false,
  },
  "minimap": {
    "max_width_columns": 80,
    "current_line_highlight": "all",
    "thumb_border": "none",
    "thumb": "always",
    "show": "auto",
  },
  "helix_mode": true,
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "sidebar_side": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^ls\\s",
            },
          ],
        },
        "fetch": {
          "default": "allow",
        },
      },
    },
    "play_sound_when_agent_done": "always",
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-5",
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gemini-3-pro-preview",
      },
    ],
    "model_parameters": [],
  },
  "edit_predictions": {
    "disabled_globs": ["*.env"],
    "mode": "subtle",
    "provider": "copilot",
    "copilot": {
      "enable_next_edit_suggestions": false,
    },
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
  },
  "git": {
    "git_gutter": "tracked_files",
    "enable_status": false,
    "inline_blame": {
      "show_commit_summary": true,
      "enabled": true,
    },
  },
  "base_keymap": "VSCode",
  "git_panel": {
    "dock": "left",
    "button": false,
  },
  "autosave": "on_focus_change",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "file_types": {
    "gotmpl": ["*.tmpl"],
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Everforest Blurred",
  },
  "languages": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "alejandra", // or "nixfmt"
          "arguments": ["--quiet", "--"],
        },
      },
    },
    "HTML": {
      "formatter": "language_server",
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
      },
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
      },
    },
    "Markdown": {
      "formatter": {
        "external": {
          "command": "dprint",
          "arguments": ["fmt", "--stdin", "{buffer_path}"],
        },
      },
    },
  },
  "code_actions_on_format": {
    "source.organizeImports.biome": true,
    "source.fixAll.biome": true,
  },
}
