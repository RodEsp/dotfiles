{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "codesearch": "allow",
    "doom_loop": "ask",
    "external_directory": "ask",
    "glob": "allow",
    "grep": "allow",
    "head": "allow",
    "list": "allow",
    "lsp": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "task": {
      "*": "ask",
      "explore": "allow"
    },
    "todoread": "allow",
    "todowrite": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "awk": "ask",
      "brew": "ask",
      "cat *": "ask",
      "echo *": "allow",
      "find *": "allow",
      "gh issue view *": "allow",
      "gh pr diff *": "allow",
      "gh pr view *": "allow",
      "git *": "ask",
      "go build *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "golangci-lint *": "allow",
      "golangci-lint": "allow",
      "grep *": "allow",
      "head": "allow",
      "head *": "allow",
      "jj *": "ask",
      "jj bookmark list": "allow",
      "jj diff *": "allow",
      "jj log *": "allow",
      "jj log": "allow",
      "jj status *": "allow",
      "jj status": "allow",
      "ls *": "allow",
      "ls": "allow",
      "npm run build *": "allow",
      "npm run typecheck *": "allow",
      "npx biome *": "allow",
      "npx tsc *": "allow",
      "npx vitest *": "allow",
      "perl": "ask",
      "python": "ask",
      "python3": "ask",
      "rg *": "allow",
      "sed -n *": "allow",
      "sed": "ask",
      "sort *": "allow",
      "tail *": "allow",
      "tee": "ask",
      "terraform fmt *": "allow",
      "tree *": "allow",
      "wc *": "allow",
      "xargs *": "allow",
      "xargs": "allow"
    },
    "skill": {
      "caveman": "allow"
    }
  },
  "agent": {
    "ask": {
      "description": "Answers general questions without modifying your code.",
      "prompt": "You are an experienced but humble software engineer that can answer questions but does not modify code. You automatically use the webfetch tool to search the internet for relevant information, and also make use of the @explore subagent to understand the codebase deeply. Also, you NEVER modify or write files, no matter what. If you want to modify or write a file, you ALWAYS ask the user to do it for you.",
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "edit": "deny"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },
  "mcp": {},
  "plugin": ["file://~/.config/opencode/plugins/notifications.ts"],
  "provider": {
    "github-copilot": {
      "models": {
        "claude-opus-4-6": {
          "limit": { "context": 1000000, "output": 128000 }
        },
        "claude-sonnet-4-6": {
          "limit": { "context": 1000000, "output": 64000 }
        },
        "claude-sonnet-4-5": {
          "limit": { "context": 1000000, "output": 64000 }
        },
        "claude-sonnet-4-20250514": {
          "limit": { "context": 1000000, "output": 64000 }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  }
}
